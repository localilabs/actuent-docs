{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms.html",
      "use": "@vercel/static"
    },
    {
      "src": "bot.html",
      "use": "@vercel/static"
    },
    {
      "src": "actuent.mcpb",
      "use": "@vercel/static"
    },
    {
      "src": "changelog.html",
      "use": "@vercel/static"
    },
    {
      "src": "changelog.xml",
      "use": "@vercel/static"
    },
    {
      "src": "generator.html",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; connect-src 'self' https://api.actuent.ai https://agents.actuent.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/generator/?",
      "dest": "/generator.html"
    },
    {
      "src": "/llms.txt",
      "dest": "/llms.txt",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/changelog/?",
      "dest": "/changelog.html"
    },
    {
      "src": "/changelog.xml",
      "dest": "/changelog.xml",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8"
      }
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/bot",
      "dest": "/bot.html"
    },
    {
      "src": "/actuent.mcpb",
      "dest": "/actuent.mcpb",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment; filename=actuent.mcpb"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
