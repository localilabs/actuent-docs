{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms.html",
      "use": "@vercel/static"
    },
    {
      "src": "bot.html",
      "use": "@vercel/static"
    },
    {
      "src": "actuent.mcpb",
      "use": "@vercel/static"
    },
    {
      "src": "changelog.html",
      "use": "@vercel/static"
    },
    {
      "src": "changelog.xml",
      "use": "@vercel/static"
    },
    {
      "src": "generator.html",
      "use": "@vercel/static"
    },
    {
      "src": "llms.txt",
      "use": "@vercel/static"
    },
    {
      "src": "guides.html",
      "use": "@vercel/static"
    },
    {
      "src": "examples.html",
      "use": "@vercel/static"
    },
    {
      "src": "lawpy.js",
      "use": "@vercel/static"
    },
    {
      "src": "playground.html",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "checklist.html",
      "use": "@vercel/static"
    },
    {
      "src": "slack.html",
      "use": "@vercel/static"
    },
    {
      "src": "stickers.html",
      "use": "@vercel/static"
    },
    {
      "src": "stickers/**",
      "use": "@vercel/static"
    },
    {
      "src": "discord.html",
      "use": "@vercel/static"
    },
    {
      "src": "connect.html",
      "use": "@vercel/static"
    },
    {
      "src": "lawpy/*.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; connect-src 'self' https://api.actuent.ai https://agents.actuent.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/examples/?",
      "dest": "/examples.html"
    },
    {
      "src": "/guides/?",
      "dest": "/guides.html"
    },
    {
      "src": "/generator/?",
      "dest": "/generator.html"
    },
    {
      "src": "/playground/?",
      "dest": "/playground.html"
    },
    {
      "src": "/checklist/?",
      "dest": "/checklist.html"
    },
    {
      "src": "/lawpy/(.+\\.svg)",
      "dest": "/lawpy/$1",
      "headers": {
        "Content-Type": "image/svg+xml",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(connect|play)/?",
      "dest": "/connect.html"
    },
    {
      "src": "/slack/?",
      "dest": "/slack.html"
    },
    {
      "src": "/discord/?",
      "dest": "/discord.html"
    },
    {
      "src": "/stickers/?",
      "dest": "/stickers.html"
    },
    {
      "src": "/stickers/(.+)",
      "dest": "/stickers/$1"
    },
    {
      "src": "/lawpy.js",
      "dest": "/lawpy.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/llms.txt",
      "dest": "/llms.txt",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/changelog/?",
      "dest": "/changelog.html"
    },
    {
      "src": "/changelog.xml",
      "dest": "/changelog.xml",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8"
      }
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/ai-ready",
      "dest": "/ai-ready.html"
    },
    {
      "src": "/bot",
      "dest": "/bot.html"
    },
    {
      "src": "/actuent.mcpb",
      "dest": "/actuent.mcpb",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment; filename=actuent.mcpb"
      }
    },
    {
      "src": "/(index\\.html)?",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
